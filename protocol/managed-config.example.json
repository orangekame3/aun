{
  "inference": {
    "llama_cli": "llama-completion",
    "model_path": "models/gemma-4-E4B-it-Q4_K_M.gguf",
    "prompt_cache": "models/gemma-4-E4B-it.prompt-cache",
    "context_size": 4096,
    "max_tokens": 24,
    "temperature": 0.2,
    "gpu_layers": 99
